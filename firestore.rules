rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role', 'createdAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.role in ['user', 'seller', 'influencer'] &&
             data.createdAt == request.time &&
             (data.get('phoneNumber', '') is string) &&
             (data.get('email', '') is string) &&
             (data.get('displayName', '') is string) &&
             (data.get('photoURL', '') is string);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId); 
      
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId) && isValidId(userId) && 
                      incoming().uid == existing().uid &&
                      incoming().role == existing().role &&
                      incoming().createdAt == existing().createdAt &&
                      isValidUser(incoming());
      
      allow delete: if false;
    }
  }
}
